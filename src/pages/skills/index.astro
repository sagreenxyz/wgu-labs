---
import "../../styles/global.css";
import { videoTasks } from "../../data/videoTasks";

// Convert titles to URL-friendly slugs
function titleToSlug(title: string): string {
	return title
		.toLowerCase()
		.replace(/[&]/g, 'and')
		.replace(/[^\w\s-]/g, '')
		.replace(/\s+/g, '-')
		.replace(/-+/g, '-')
		.replace(/^-+|-+$/g, '');
}

// Map of skills to their available resources
const skillResources: Record<string, string[]> = {
	// Video + Checklist skills
	"Orthostatic Vital Signs": ["Watch", "Checklist"],
	"Open Hand Hygiene Video": ["Watch", "Checklist"],
	"Using Personal Protective Equipment": ["Watch", "Checklist"],
	"Performing a Complete or Partial Bed Bath": ["Watch", "Checklist"],
	"Making an Occupied Bed": ["Watch", "Checklist"],
	"Assisting With a Bedpan": ["Watch", "Checklist"],
	"Measuring Intake and Output": ["Watch", "Checklist"],
	"Performing Oral Hygiene for an Unconscious Patient": ["Watch", "Checklist"],
	"Taking Temperatures": ["Watch", "Checklist"],
	"Assessing Radial Pulse": ["Watch", "Checklist"],
	"Assessing Apical Pulse": ["Watch", "Checklist"],
	"Assessing Apical-Radial Pulse": ["Watch", "Checklist"],
	"Assessing Respiration: Rate, Rhythm, and Effort": ["Watch", "Checklist"],
	"Obtaining Blood Pressure by the One-Step Method": ["Watch", "Checklist"],
	"Obtaining Blood Pressure by the Two-Step Method": ["Watch", "Checklist"],
	"Measuring Oxygen Saturation with Pulse Oximetry": ["Watch", "Checklist"],
	"Assessing Pain": ["Watch", "Checklist"],
	"Collecting a Midstream Urine Specimen": ["Watch", "Quick Sheet"],
	"Performing Blood Glucose Testing": ["Watch", "Checklist"],
	"Administering Oral Medications": ["Watch", "Checklist"],
	"Documenting Medication Administration": ["Watch"],
	"Handling Medication Variations": ["Watch"],
	"Preventing Medication Errors": ["Watch", "Checklist"],
	"Preparing Injections from an Ampule": ["Watch", "Checklist"],
	"Preparing Injections from a Vial": ["Watch", "Checklist"],
	"Preparing and Administering Insulin": ["Watch", "Quick Sheet"],
	"Drawing Up More Than One Type of Insulin": ["Watch", "Checklist"],
	"Administering Intradermal Injections": ["Watch"],
	"Administering Subcutaneous Injections": ["Watch", "Checklist"],
	"Administering Intramuscular Injections": ["Watch", "Checklist"],
	"Performing a Disposable Bed Bath": ["Watch", "Checklist"],
	"Establishing and Maintaining a Sterile Field": ["Watch", "Checklist"],
	"Adding Items to a Sterile Field": ["Watch"],
	"Pouring a Sterile Solution": ["Watch"],
	"Using a Prepackaged Sterile Kit": ["Watch"],
	"Performing Sterile Gloving": ["Watch", "Checklist"],
	"Ensuring Oxygen Safety": ["Watch", "Checklist"],
	"Setting Oxygen Flow Rates": ["Watch", "Checklist"],
	"Inserting an Indwelling Urinary Catheter in a Female Patient": ["Watch", "Checklist"],
	"Inserting an Indwelling Urinary Catheter in a Male Patient": ["Watch", "Checklist"],
	"Removing an Indwelling Urinary Catheter": ["Watch"],
	// PDF only skills
	"Administering Nebulized Medications": ["Checklist"],
	"Applying Topical Medications": ["Checklist"],
	"Applying a Nasal Canula or Face Mask": ["Checklist"],
	"Head-to-Toe Assessment": ["Checklist"],
	"Inserting a Nasogastric Tube": ["Checklist"],
	"Obtaining a Specimen from an Indwelling Urinary Catheter": ["Checklist"],
	"Performing Oropharyngeal Suctioning": ["Checklist"],
	"Providing Enteral Feedings": ["Checklist"],
	"Removing a Feeding Tube": ["Checklist"],
	"Transferring From a Bed to a Stretcher": ["Checklist"],
	"Transferring From a Bed to a Wheelchair Using a Transfer Belt": ["Checklist"],
};

// Combine all skills
const allSkills = [
	...videoTasks.map((task) => ({ ...task, resources: skillResources[task.title] || ["Watch"] })),
	...Object.entries(skillResources)
		.filter(([title]) => !videoTasks.some((task) => task.title === title))
		.map(([title, resources]) => ({ title, videoUrl: "", resources })),
].sort((a, b) => a.title.localeCompare(b.title));

const completedSkills = new Set([
	"Adding Items to a Sterile Field",
	"Administering Intramuscular Injections",
	"Administering Nebulized Medications",
	"Assessing Apical Pulse",
	"Assessing Apical-Radial Pulse",
	"Assisting With a Bedpan",
	"Using Personal Protective Equipment",
	"Using a Prepackaged Sterile Kit",
]);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Skills</title>
	</head>
	<body class="bg-base-200 min-h-screen">
		<main class="mx-auto max-w-6xl p-6 lg:p-10">
			<div class="breadcrumbs text-sm mb-6">
				<ul>
					<li><a href={import.meta.env.BASE_URL}>Home</a></li>
					<li>Skills</li>
				</ul>
			</div>

			<section class="hero bg-base-100 rounded-box shadow-xl mb-8">
				<div class="hero-content w-full flex-col items-start gap-4">
					<h1 class="text-4xl font-bold">Skills Library</h1>
					<p class="text-lg opacity-80">{allSkills.length} skills &mdash; {completedSkills.size} complete, {allSkills.length - completedSkills.size} remaining</p>
				</div>
			</section>

			<div class="tabs tabs-border tabs-lg mb-6">
				<input type="radio" name="skills_tabs" class="tab" aria-label={`Incomplete (${allSkills.length - completedSkills.size})`} checked />
				<div class="tab-content pt-6">
					<section class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
						{allSkills.filter(skill => !completedSkills.has(skill.title)).map((skill) => {
							const slug = titleToSlug(skill.title);
							return (
								<a href={`${import.meta.env.BASE_URL}/skills/${slug}`} class="card bg-base-100 shadow-md hover:shadow-xl transition-shadow border border-base-300">
									<div class="card-body">
										<div class="card-actions justify-end">
											<div class="badge badge-warning">Incomplete</div>
										</div>
										<h2 class="card-title text-lg line-clamp-2">{skill.title}</h2>
										<div class="card-actions justify-end flex-wrap gap-2">
											{skill.resources.map((resource) => (
												<div class="badge badge-outline">{resource}</div>
											))}
										</div>
									</div>
								</a>
							);
						})}
					</section>
				</div>

				<input type="radio" name="skills_tabs" class="tab" aria-label={`Complete (${completedSkills.size})`} />
				<div class="tab-content pt-6">
					<section class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
						{allSkills.filter(skill => completedSkills.has(skill.title)).map((skill) => {
							const slug = titleToSlug(skill.title);
							return (
								<a href={`${import.meta.env.BASE_URL}/skills/${slug}`} class="card bg-base-100 shadow-md hover:shadow-xl transition-shadow border border-success/30">
									<div class="card-body">
										<div class="card-actions justify-end">
											<div class="badge badge-success">Complete</div>
										</div>
										<h2 class="card-title text-lg line-clamp-2">{skill.title}</h2>
										<div class="card-actions justify-end flex-wrap gap-2">
											{skill.resources.map((resource) => (
												<div class="badge badge-outline">{resource}</div>
											))}
										</div>
									</div>
								</a>
							);
						})}
					</section>
				</div>
			</div>
		</main>
	</body>
</html>
