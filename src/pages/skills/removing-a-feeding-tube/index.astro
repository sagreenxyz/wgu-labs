---
import "../../../styles/global.css";
import SkillResourceModal from "../../../components/SkillResourceModal.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Removing a Feeding Tube</title>
	</head>
	<body class="bg-base-200 min-h-screen">
		<main class="mx-auto max-w-4xl p-6 lg:p-10">
			<div class="breadcrumbs text-sm mb-6">
				<ul>
					<li><a href={import.meta.env.BASE_URL}>Home</a></li>
					<li><a href={`${import.meta.env.BASE_URL}/skills`}>Skills</a></li>
					<li>Removing a Feeding Tube</li>
				</ul>
			</div>

			<section class="hero bg-base-100 rounded-box shadow-xl">
				<div class="hero-content w-full flex-col items-start gap-4">
					<h1 class="text-4xl font-bold">Removing a Feeding Tube</h1>
					<a href={`${import.meta.env.BASE_URL}/skills/checklists/Removing a Feeding Tube - Checklist.pdf`} class="btn btn-outline resource-link">
						Checklist
					</a>
				</div>
			</section>

			<!-- Checklist -->
			<div class="card bg-base-100 shadow-xl mt-6">
				<div class="card-body">
					<h2 class="card-title text-2xl">Checklist</h2>
					<div class="flex items-center gap-4 mb-4">
						<progress id="cl-progress" class="progress progress-success flex-1" value="0" max="26"></progress>
						<span id="cl-count" class="text-sm font-medium">0 / 26</span>
						<button onclick="resetChecklist()" class="btn btn-sm btn-outline">Reset</button>
					</div>

					<ul class="space-y-2">
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Verified the health care provider's orders.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Gathered the necessary equipment and supplies.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Performed hand hygiene, donned gloves and appropriate PPE as needed, and provided for the patient's privacy.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Introduced self to the patient and family.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Identified the patient using two identifiers and compared identifiers with the patient's identification bracelet.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Explained the procedure and ensured the patient agreed to treatment.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Positioned the patient in semi-Fowler or high-Fowler position as tolerated and raised the bed to a comfortable working level.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Placed a clean towel over the patient's chest and provided facial tissues.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Clamped the NG tube.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>If connected to suction, turned off suction and disconnected the NG tube from it.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>If connected to an enteral feeding system, turned off the feeding pump and disconnected the NG tube from the tubing.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Measured the amount of drainage and evaluated the character of the contents.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Instilled a small amount of air into the lumen of the NG tube to clear the tube.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Removed the tape, membrane dressing, or tube-fixation device securing the feeding tube.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Instructed the patient to take a deep breath and hold it.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Grasped the tube and pulled it out steadily and smoothly; inspected it to ensure it was intact and notified the practitioner if not intact.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Instructed the patient to breathe normally.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Removed gloves and performed hand hygiene, then donned clean gloves.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Offered tissues to the patient to blow his or her nose.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Offered mouth care to the patient.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Helped the patient into a comfortable position, placed toiletries and personal items within reach, and explained fluid intake if not contraindicated.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Placed the call light within easy reach and made sure the patient knew how to use it to summon assistance.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Raised the appropriate number of side rails and lowered the bed to the lowest position.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Disposed of used supplies and equipment and left the patient's room tidy.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Removed and disposed of gloves, if used, and performed hand hygiene.</span></li>
						<li class="flex items-start gap-2"><input type="checkbox" class="checkbox checkbox-sm cl-item mt-1" /><span>Documented and reported the patient's response and expected or unexpected outcomes.</span></li>
					</ul>
				</div>
			</div>

			<SkillResourceModal />
		</main>
	</body>
</html>

<script>
	function updateProgress() {
		const items = document.querySelectorAll('.cl-item');
		const checked = document.querySelectorAll('.cl-item:checked').length;
		const progress = document.getElementById('cl-progress') as HTMLProgressElement;
		const count = document.getElementById('cl-count');
		if (progress) progress.value = checked;
		if (count) count.textContent = `${checked} / ${items.length}`;
	}

	function resetChecklist() {
		document.querySelectorAll('.cl-item').forEach((el) => {
			(el as HTMLInputElement).checked = false;
		});
		updateProgress();
	}

	document.querySelectorAll('.cl-item').forEach((el) => {
		el.addEventListener('change', updateProgress);
	});
</script>
