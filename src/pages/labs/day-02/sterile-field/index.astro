					<p>Elsevier Performance Manager video for sterile field setup and maintenance.</p>
					<div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
						<a
							href="/labs/day-02/sterile-field/establishing-sterile-field"
							class="btn btn-primary"
						>
							Establishing and Maintaining a Sterile Field
						</a>
						<a
							href="/labs/day-02/sterile-field/adding-items-to-sterile-field"
							class="btn btn-outline"
						>
							Adding Items to a Sterile Field
						</a>
						<a
							href="/labs/day-02/sterile-field/pouring-sterile-solution"
							class="btn btn-outline"
						>
							Pouring a Sterile Solution
						</a>
						<a
							href="/labs/day-02/sterile-field/prepackaged-sterile-kit"
							class="btn btn-outline"
						>
							Using a Prepackaged Sterile Kit
						</a>
					</div>
				</div>
			</section>
		</main>
