---
import "../../../../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Labs - Day 2 - Indwelling Urinary Catheter</title>
	</head>
	<body class="bg-base-200 min-h-screen">
		<main class="mx-auto max-w-4xl p-6 lg:p-10">
			<div class="breadcrumbs text-sm mb-6">
				<ul>
					<li><a href={import.meta.env.BASE_URL}>Home</a></li>
					<li><a href={`${import.meta.env.BASE_URL}/labs`}>Labs</a></li>
					<li><a href={`${import.meta.env.BASE_URL}/labs/day-02`}>Day 2</a></li>
					<li>Indwelling Urinary Catheter</li>
				</ul>
			</div>

			<section class="hero bg-base-100 rounded-box shadow-xl mb-6">
				<div class="hero-content w-full flex-col items-start gap-3">
					<div class="badge badge-primary badge-outline">Day 2</div>
					<h1 class="text-4xl font-bold">Indwelling Urinary Catheter</h1>
					<p class="text-lg opacity-80">Skills/topic page in the three-day lab roadmap.</p>
				</div>
			</section>

			<section class="card bg-base-100 shadow-xl border border-base-300">
				<div class="card-body">
					<h2 class="card-title">Learning Resource</h2>
					<p>Elsevier Performance Manager video for female indwelling urinary catheter insertion.</p>
					<div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
						<a
							href={`${import.meta.env.BASE_URL}/labs/day-02/indwelling-urinary-catheter/catheter-female`}
							class="btn btn-primary"
						>
							Inserting an Indwelling Urinary Catheter in a Female Patient
						</a>
						<a
							href={`${import.meta.env.BASE_URL}/labs/day-02/indwelling-urinary-catheter/catheter-male`}
							class="btn btn-outline"
						>
							Inserting an Indwelling Urinary Catheter in a Male Patient
						</a>
						<a
							href={`${import.meta.env.BASE_URL}/labs/day-02/indwelling-urinary-catheter/removing-catheter`}
							class="btn btn-outline"
						>
							Removing an Indwelling Urinary Catheter
						</a>
					</div>
				</div>
			</section>
		</main>
	</body>
</html>
