---
import "../../../styles/global.css";

const items = [
	{ title: "Hand Hygiene", href: `${import.meta.env.BASE_URL}/labs/day-01/hand-hygiene` },
	{ title: "PPE", href: `${import.meta.env.BASE_URL}/labs/day-01/ppe` },
	{ title: "Vital Signs", href: `${import.meta.env.BASE_URL}/labs/day-01/vital-signs` },
	{ title: "Pain Assessment", href: `${import.meta.env.BASE_URL}/labs/day-01/pain-assessment` },
	{ title: "Transfers", href: `${import.meta.env.BASE_URL}/labs/day-01/transfers` },
	{ title: "Gait Belt", href: `${import.meta.env.BASE_URL}/labs/day-01/gait-belt` },
	{ title: "Oral Hygiene on Unconscious Patient", href: `${import.meta.env.BASE_URL}/labs/day-01/oral-hygiene-on-unconscious-patient` },
	{ title: "Bed Bath", href: `${import.meta.env.BASE_URL}/labs/day-01/bed-bath` },
	{ title: "Linen Change of an Occupied Bed", href: `${import.meta.env.BASE_URL}/labs/day-01/linen-change-of-an-occupied-bed` },
	{ title: "Intake and Output", href: `${import.meta.env.BASE_URL}/labs/day-01/intake-and-output` },
	{ title: "Urine Specimen Collection", href: `${import.meta.env.BASE_URL}/labs/day-01/urine-specimen-collection` },
	{ title: "Bedpan", href: `${import.meta.env.BASE_URL}/labs/day-01/bedpan` },
	{ title: "Blood Glucose Monitoring", href: `${import.meta.env.BASE_URL}/labs/day-01/blood-glucose-monitoring` },
	{ title: "Medication Administration (PO, SQ, IM, 6 Administration Rights)", href: `${import.meta.env.BASE_URL}/labs/day-01/medication-administration` }
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Labs - Day 1</title>
	</head>
	<body class="bg-base-200 min-h-screen">
		<main class="mx-auto max-w-6xl p-6 lg:p-10">
			<div class="breadcrumbs text-sm mb-6">
				<ul>
					<li><a href={import.meta.env.BASE_URL}>Home</a></li>
					<li><a href={`${import.meta.env.BASE_URL}/labs`}>Labs</a></li>
					<li>Day 1</li>
				</ul>
			</div>
			<section class="hero bg-base-100 rounded-box shadow-xl mb-8">
				<div class="hero-content w-full flex-col items-start gap-4">
					<div class="badge badge-primary badge-outline">Three-Day Lab Roadmap</div>
					<h1 class="text-4xl font-bold">Day 1</h1>
					<p class="text-lg">Foundational bedside skills.</p>
					<div class="badge badge-outline badge-lg">{items.length} skills</div>
				</div>
			</section>
			<section class="card bg-base-100 shadow-xl border border-base-300">
				<div class="card-body">
					<h2 class="card-title">Skills and Topics</h2>
					<div class="grid gap-2 sm:grid-cols-2">
						{items.map((item) => (
							<a href={item.href} class="alert bg-base-200 border border-base-300 py-2 min-h-0 hover:bg-base-300 transition-colors">
								<span>{item.title}</span>
							</a>
						))}
					</div>
				</div>
			</section>
		</main>
	</body>
</html>