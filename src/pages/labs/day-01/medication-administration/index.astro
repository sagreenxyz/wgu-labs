---
import "../../../../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Labs - Day 1 - Medication Administration (PO, SQ, IM, 6 Administration Rights)</title>
	</head>
	<body class="bg-base-200 min-h-screen">
		<main class="mx-auto max-w-4xl p-6 lg:p-10">
			<div class="breadcrumbs text-sm mb-6">
				<ul>
					<li><a href="/">Home</a></li>
					<li><a href="/labs">Labs</a></li>
					<li><a href="/labs/day-01">Day 1</a></li>
					<li>Medication Administration (PO, SQ, IM, 6 Administration Rights)</li>
				</ul>
			</div>

			<section class="hero bg-base-100 rounded-box shadow-xl mb-6">
				<div class="hero-content w-full flex-col items-start gap-3">
					<div class="badge badge-primary badge-outline">Day 1</div>
					<h1 class="text-4xl font-bold">Medication Administration (PO, SQ, IM, 6 Administration Rights)</h1>
					<p class="text-lg opacity-80">Skills/topic page in the three-day lab roadmap.</p>
				</div>
			</section>

			<section class="card bg-base-100 shadow-xl border border-base-300">
				<div class="card-body">
					<h2 class="card-title">Learning Resource</h2>
					<p>Elsevier Performance Manager video for oral medication administration.</p>
					<div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
						<a
							href="/labs/day-01/medication-administration/oral-medications"
							class="btn btn-primary"
						>
							Administering Oral Medications
						</a>
						<a
							href="/labs/day-01/medication-administration/documenting-medication-administration"
							class="btn btn-outline"
						>
							Documenting Medication Administration
						</a>
						<a
							href="/labs/day-01/medication-administration/handling-medication-variations"
							class="btn btn-outline"
						>
							Handling Medication Variations
						</a>
						<a
							href="/labs/day-01/medication-administration/preventing-medication-errors"
							class="btn btn-outline"
						>
							Preventing Medication Errors
						</a>
						<a
							href="/labs/day-01/medication-administration/injections-from-ampule"
							class="btn btn-outline"
						>
							Preparing Injections from an Ampule
						</a>
						<a
							href="/labs/day-01/medication-administration/injections-from-vial"
							class="btn btn-outline"
						>
							Preparing Injections from a Vial
						</a>
						<a
							href="/labs/day-01/medication-administration/preparing-and-administering-insulin"
							class="btn btn-outline"
						>
							Preparing and Administering Insulin
						</a>
						<a
							href="/labs/day-01/medication-administration/drawing-up-two-insulins"
							class="btn btn-outline"
						>
							Drawing Up More Than One Type of Insulin
						</a>
						<a
							href="/labs/day-01/medication-administration/intradermal-injections"
							class="btn btn-outline"
						>
							Administering Intradermal Injections
						</a>
						<a
							href="/labs/day-01/medication-administration/subcutaneous-injections"
							class="btn btn-outline"
						>
							Administering Subcutaneous Injections
						</a>
						<a
							href="/labs/day-01/medication-administration/intramuscular-injections"
							class="btn btn-outline"
						>
							Administering Intramuscular Injections
						</a>
