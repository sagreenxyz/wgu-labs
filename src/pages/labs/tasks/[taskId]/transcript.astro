---
// @ts-nocheck
import "../../../../styles/global.css";
import { videoTasks } from "../../../../data/videoTasks";

export function getStaticPaths() {
	return videoTasks
		.filter((task) => Boolean(task.transcript))
		.map((task) => ({
			params: { taskId: task.id },
			props: { task }
		}));
}

const { task } = Astro.props;
const paragraphs = task.transcript
	? task.transcript.split("\n\n").map((p) =>
		p.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
	)
	: [];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Transcript - {task.title}</title>
	</head>
	<body class="bg-base-200 min-h-screen">
		<main class="mx-auto max-w-5xl p-6 lg:p-10">
			<div class="breadcrumbs text-sm mb-6">
				<ul>
					<li><a href="/">Home</a></li>
					<li><a href="/labs">Labs</a></li>

					<li><a href={task.taskPath}>{task.title}</a></li>
					<li>Transcript</li>
				</ul>
			</div>

			<section class="hero bg-base-100 rounded-box shadow-xl mb-8">
				<div class="hero-content w-full flex-col items-start gap-4 lg:flex-row lg:items-center lg:justify-between">
					<div>
						<div class="badge badge-primary badge-outline mb-3">{task.dayLabel}</div>
						<h1 class="text-4xl font-bold">Transcript</h1>
						<p class="text-lg opacity-80">{task.title}</p>
					</div>
					<div class="flex gap-2 flex-wrap">
						<a href={task.taskPath} class="btn btn-outline">Back to Task</a>
						<a href={task.videoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Open Video</a>
					</div>
				</div>
			</section>

			<section class="card bg-base-100 shadow-xl border border-base-300">
				<div class="card-body">
					<div class="prose max-w-none">
						{paragraphs.map((paragraph) => (
							<p set:html={paragraph} />
						))}
					</div>
				</div>
			</section>
		</main>
	</body>
</html>
