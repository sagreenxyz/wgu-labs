---
import "../styles/global.css";

const feature = {
	title: "Simulation Learning System",
	href: `${import.meta.env.BASE_URL}/simulation-learning-system`,
	description: "A supporting case experience for selected scenarios inside the broader three-day lab sequence.",
	status: "2 cases live",
	meta: "Fundamentals only",
	highlights: ["Bernadette Jackson", "Lisa Rae", "More cases planned"]
};

const labDays = [
	{
		label: "Day 1",
		focus: "Foundational bedside skills",
		items: [
			"Hand Hygiene",
			"PPE",
			"Vital Signs",
			"Pain Assessment",
			"Transfers",
			"Gait Belt",
			"Oral Hygiene on Unconscious Patient",
			"Bed Bath",
			"Linen Change of an Occupied Bed",
			"Intake and Output",
			"Urine Specimen Collection",
			"Bedpan",
			"Blood Glucose Monitoring",
			"Medication Administration (PO, SQ, IM, 6 Administration Rights)"
		]
	},
	{
		label: "Day 2",
		focus: "Intermediate procedures",
		items: [
			"Oxygen Delivery and Flow Rates",
			"Oropharyngeal Suctioning",
			"Head to Toe (Full versus Focused)",
			"Sterile Gloving",
			"Sterile Field",
			"Indwelling Urinary Catheter",
			"Mediation Administration (Topical, Nebulizers)",
			"Nasogastric Tube Insertion and Removal",
			"Enteral Feedings"
		]
	},
	{
		label: "Day 3",
		focus: "Clinical reasoning and simulation",
		items: [
			"Nursing Process",
			"Concept Mapping",
			"Clinical Judgment Model",
			"Lisa Rae (Simulation 5)",
			"Bernadette Jackson (Simulation 2)"
		]
	}
];

const totalSkills = labDays.reduce((total, day) => total + day.items.length, 0);
const labsHref = `${import.meta.env.BASE_URL}/labs`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>WGU Labs</title>
	</head>
	<body class="bg-base-200 min-h-screen">
		<main class="mx-auto max-w-7xl p-6 lg:p-10">
			<section class="mb-8">
				<div class="card bg-gradient-to-br from-base-100 to-base-300 shadow-2xl border border-base-300 overflow-hidden">
					<div class="card-body gap-8 lg:flex-row lg:items-end lg:justify-between">
						<div class="max-w-3xl">
							<div class="badge badge-primary badge-outline mb-4">WGU Labs</div>
							<h1 class="text-4xl lg:text-5xl font-bold leading-tight">The Three-Day Lab Roadmap is the core learning path.</h1>
							<p class="py-4 text-lg max-w-2xl">
								Use the roadmap below as the primary structure for skills practice and progression. The Simulation Learning System currently supports two of those fundamentals cases: Bernadette Jackson and Lisa Rae.
							</p>
							<div class="flex flex-wrap gap-2 mb-5">
								{labDays.map((day) => (
									<span class="badge badge-outline badge-lg">{day.label}</span>
								))}
							</div>
						</div>

						<div class="w-full max-w-md">
							<div class="card bg-base-100 shadow-xl border border-base-300">
								<div class="card-body gap-4">
									<div class="flex items-start justify-between gap-4">
										<div>
											<div class="badge badge-success badge-outline mb-3">{feature.status}</div>
											<h2 class="card-title text-2xl">{feature.title}</h2>
										</div>
										<div class="badge badge-neutral badge-outline">{feature.meta}</div>
									</div>
									<p>{feature.description}</p>
									<div class="flex flex-wrap gap-2">
										{feature.highlights.map((item) => (
									<span class="badge badge-outline badge-lg">{item}</span>
								))}
							</div>
									<div class="stats stats-horizontal bg-base-200 shadow-sm">
										<div class="stat px-4">
											<div class="stat-title">Lab Days</div>
											<div class="stat-value text-2xl">{labDays.length}</div>
										</div>
										<div class="stat px-4">
											<div class="stat-title">Skills</div>
											<div class="stat-value text-2xl">{totalSkills}</div>
										</div>
									</div>
									<div class="card-actions mt-2">
										<a href={feature.href} class="btn btn-primary w-full">Open Supporting Cases</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section>
				<div class="card bg-base-100 shadow-xl border border-base-300">
					<div class="card-body">
						<div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between mb-2">
							<div>
								<h2 class="card-title text-2xl">Three-Day Lab Roadmap</h2>
								<p class="text-sm opacity-70">This is the main learning sequence. Expand each day to review the skills and topics covered in the lab progression.</p>
							</div>
							<div class="flex flex-wrap items-center gap-3">
								<div class="badge badge-primary badge-outline">{totalSkills} total skills</div>
								<a href={labsHref} class="btn btn-outline btn-sm">Open Labs</a>
		
								<a href={`${import.meta.env.BASE_URL}/labs/report`} class="btn btn-secondary btn-sm">Progress Report</a>
							</div>
						</div>

						<div class="join join-vertical w-full">
							{labDays.map((day, index) => (
								<div class="collapse collapse-arrow join-item border border-base-300 bg-base-200">
									<input type="radio" name="lab-roadmap" checked={index === 0} />
									<div class="collapse-title">
										<div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
											<div>
												<div class="font-semibold text-lg">{day.label}</div>
												<div class="text-sm opacity-70">{day.focus}</div>
											</div>
											<div class="badge badge-outline">{day.items.length} skills</div>
										</div>
									</div>
									<div class="collapse-content">
										<div class="flex justify-end pb-3">
											<a href={`${import.meta.env.BASE_URL}/labs/day-0${index + 1}`} class="btn btn-primary btn-sm">Open {day.label}</a>
										</div>
										<div class="grid gap-2 sm:grid-cols-2 pt-2">
											{day.items.map((item) => (
												<div class="alert bg-base-100 border border-base-300 py-2 min-h-0">
													<span>{item}</span>
												</div>
											))}
										</div>
									</div>
								</div>
							))}
						</div>
					</div>
				</div>
			</section>
		</main>
	</body>
</html>
