---
import "../../../../styles/global.css";
import caseData from "./case-data.json";

const { scenario, patient, concepts, skills, presentation, primaryChallenge } = caseData;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{scenario.title} - {patient.name}</title>
	</head>
	<body class="bg-base-200 min-h-screen">
		<main class="mx-auto max-w-7xl p-6 lg:p-10">
			<div class="breadcrumbs text-sm mb-6">
				<ul>
					<li><a href="/">Home</a></li>
					<li><a href="/simulation-learning-system">Simulation Learning System</a></li>
					<li><a href="/simulation-learning-system/fundamentals">Fundamentals</a></li>
					<li>{patient.name}</li>
				</ul>
			</div>

			<section class="hero bg-base-100 rounded-box shadow-xl mb-8">
				<div class="hero-content w-full flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
					<div>
						<div class="flex flex-wrap gap-2 mb-4">
							<div class="badge badge-primary badge-outline">{scenario.title}</div>
							<div class="badge badge-accent badge-outline">{presentation.diagnoses.primary}</div>
							<div class="badge badge-info badge-outline">{presentation.diagnoses.secondary}</div>
						</div>
						<h1 class="text-4xl font-bold text-balance">{patient.name}</h1>
						<p class="py-3 text-lg max-w-3xl">{presentation.summary}</p>
					</div>

					<div class="stats stats-vertical shadow bg-base-200 w-full lg:w-auto">
						<div class="stat">
							<div class="stat-title">Patient</div>
							<div class="stat-value text-2xl">{patient.age}</div>
							<div class="stat-desc">{patient.gender}</div>
						</div>
						<div class="stat">
							<div class="stat-title">Scenario Time</div>
							<div class="stat-value text-2xl">{scenario.scenarioTime}</div>
						</div>
						<div class="stat">
							<div class="stat-title">Debrief</div>
							<div class="stat-value text-2xl">{scenario.debriefingTime}</div>
						</div>
					</div>
				</div>
			</section>

			<section class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr] mb-8">
				<div class="card bg-base-100 shadow-xl">
					<div class="card-body">
						<h2 class="card-title">Primary Challenge</h2>
						<p>{primaryChallenge}</p>
						<div class="divider my-1"></div>
						<h3 class="font-semibold">Diagnoses</h3>
						<div class="grid gap-4 md:grid-cols-2">
							<div class="alert bg-base-200 border-0">
								<div>
									<span class="font-semibold block">Primary</span>
									<span>{presentation.diagnoses.primary}</span>
								</div>
							</div>
							<div class="alert bg-base-200 border-0">
								<div>
									<span class="font-semibold block">Secondary</span>
									<span>{presentation.diagnoses.secondary}</span>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="card bg-base-100 shadow-xl">
					<div class="card-body">
						<h2 class="card-title">Patient Snapshot</h2>
						<div class="overflow-x-auto">
							<table class="table table-zebra">
								<tbody>
									<tr>
										<th>Name</th>
										<td>{patient.name}</td>
									</tr>
									<tr>
										<th>Age</th>
										<td>{patient.age}</td>
									</tr>
									<tr>
										<th>Gender</th>
										<td>{patient.gender}</td>
									</tr>
									<tr>
										<th>Scenario</th>
										<td>{scenario.title}</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</section>

			<section class="grid gap-6 lg:grid-cols-2">
				<div class="card bg-base-100 shadow-xl">
					<div class="card-body">
						<h2 class="card-title">Concepts</h2>
						<div class="flex flex-wrap gap-2">
							{concepts.map((concept) => (
								<span class="badge badge-lg badge-outline">{concept}</span>
							))}
						</div>
					</div>
				</div>

				<div class="card bg-base-100 shadow-xl">
					<div class="card-body">
						<h2 class="card-title">Scenario Skills</h2>
						<ul class="menu bg-base-200 rounded-box gap-1">
							{skills.map((skill) => (
								<li><span>{skill}</span></li>
							))}
						</ul>
					</div>
				</div>
			</section>
		</main>
	</body>
</html>
