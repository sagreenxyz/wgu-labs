---
import "../../styles/global.css";

const sections = [
	{
		title: "Fundamentals",
		href: "/simulation-learning-system/fundamentals",
		description: "Core nursing simulation cases focused on assessment, communication, safety, and foundational clinical judgment.",
		badge: "Available Now",
		count: "2 active cases",
		focus: ["Assessment", "Patient Safety", "Clinical Judgment"]
	}
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Simulation Learning System</title>
	</head>
	<body class="bg-base-200 min-h-screen">
		<main class="mx-auto max-w-7xl p-6 lg:p-10">
			<div class="breadcrumbs text-sm mb-6">
				<ul>
					<li><a href="/">Home</a></li>
					<li>Simulation Learning System</li>
				</ul>
			</div>

			<section class="hero bg-base-100 rounded-box shadow-xl mb-8">
				<div class="hero-content w-full flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
					<div class="max-w-3xl">
						<div class="badge badge-primary badge-outline mb-4">Simulation Learning System</div>
						<h1 class="text-4xl font-bold">Clinical simulation pathways</h1>
						<p class="py-3 text-lg">
							Choose a simulation track to review scenario content, diagnoses, skills, and case-specific learning objectives.
						</p>
					</div>

					<div class="stats stats-vertical shadow bg-base-200 w-full lg:w-auto">
						<div class="stat">
							<div class="stat-title">Sections</div>
							<div class="stat-value text-3xl">{sections.length}</div>
						</div>
						<div class="stat">
							<div class="stat-title">Current Focus</div>
							<div class="stat-value text-2xl">Fundamentals</div>
						</div>
					</div>
				</div>
			</section>

			<section class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
				{sections.map((section) => (
					<a href={section.href} class="card bg-base-100 shadow-xl border border-base-300 hover:shadow-2xl transition-shadow">
						<div class="card-body">
							<div class="flex items-start justify-between gap-4">
								<div>
									<div class="badge badge-success badge-outline mb-3">{section.badge}</div>
									<h2 class="card-title text-2xl">{section.title}</h2>
								</div>
								<div class="badge badge-neutral badge-outline">{section.count}</div>
							</div>

							<p>{section.description}</p>

							<div>
								<p class="font-semibold mb-2">Focus Areas</p>
								<div class="flex flex-wrap gap-2">
									{section.focus.map((item) => (
										<span class="badge badge-outline">{item}</span>
									))}
								</div>
							</div>

							<div class="card-actions justify-end mt-4">
								<span class="btn btn-primary btn-sm">Open Section</span>
							</div>
						</div>
					</a>
				))}
			</section>
		</main>
	</body>
</html>